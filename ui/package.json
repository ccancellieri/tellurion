{
  "name": "tellurion-demo-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:public-demo": "tsc && vite build --mode public-demo",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "happy-dom": "^20.0.10",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@loaders.gl/compression": {
      "fflate": "0.7.5"
    },
    "@loaders.gl/core": "$@loaders.gl/core",
    "@loaders.gl/gltf": "4.5.4",
    "@loaders.gl/textures": "4.5.4"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@deck.gl/mesh-layers": "9.4.0",
    "@loaders.gl/3d-tiles": "4.5.4",
    "@loaders.gl/core": "4.5.4",
    "@luma.gl/core": "9.4.2",
    "@luma.gl/engine": "9.4.2",
    "@math.gl/web-mercator": "^4.1.0",
    "maplibre-gl": "6.14.0",
    "yaml": "^2.8.1"
  }
}
