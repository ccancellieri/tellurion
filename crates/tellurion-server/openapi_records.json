{
  "openapi": "3.0.3",
  "info": {
    "title": "Tellurion — OGC API Records (read-only)",
    "description": "OGC API — Common (Core, landing page, conformance, OpenAPI) plus a read-only catalog surface following the resource shapes of OGC API — Records — Part 1: Core (OGC 20-004r1, approved 1.0) for one catalog. No ogcapi-records-1 conformance class is declared — see the /conformance response and the tellurion-records crate documentation for the per-class reasoning. Mounted at /{tenant}/records/catalogs/{catalog}. Only collections declared with kind: record appear here; every other kind is served by the features, tiles and stac roots.",
    "version": "0.2.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Landing page",
        "operationId": "getLandingPage",
        "responses": {
          "200": {
            "description": "Links to the API description, conformance declaration, and catalog list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/conformance": {
      "get": {
        "summary": "Conformance classes this server implements",
        "operationId": "getConformanceDeclaration",
        "responses": {
          "200": {
            "description": "List of conformance class URIs. OGC API — Common classes only: no OGC API — Records class is claimed by this root.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conformsTo": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api": {
      "get": {
        "summary": "This OpenAPI document",
        "operationId": "getApiDescription",
        "responses": {
          "200": {
            "description": "The OpenAPI 3.0 document describing this API.",
            "content": {
              "application/vnd.oai.openapi+json;version=3.0": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/collections": {
      "get": {
        "summary": "The catalogs (record collections) this root serves",
        "operationId": "getCatalogs",
        "parameters": [
          {
            "$ref": "#/components/parameters/catalogsLimit"
          },
          {
            "$ref": "#/components/parameters/token"
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog list. Only collections declared with kind: record are included.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/catalogs"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameter"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/collections/{collectionId}": {
      "get": {
        "summary": "One catalog",
        "operationId": "getCatalog",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionId"
          }
        ],
        "responses": {
          "200": {
            "description": "The catalog description.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/catalog"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/collections/{collectionId}/items": {
      "get": {
        "summary": "Records in one catalog",
        "operationId": "getRecords",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionId"
          },
          {
            "$ref": "#/components/parameters/recordsLimit"
          },
          {
            "$ref": "#/components/parameters/datetime"
          },
          {
            "$ref": "#/components/parameters/token"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of records, as a GeoJSON FeatureCollection. A record's geometry member is commonly null.",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/records"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParameter"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/collections/{collectionId}/items/{recordId}": {
      "get": {
        "summary": "One record",
        "operationId": "getRecord",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionId"
          },
          {
            "$ref": "#/components/parameters/recordId"
          }
        ],
        "responses": {
          "200": {
            "description": "One record, as a GeoJSON Feature.",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/record"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "collectionId": {
        "name": "collectionId",
        "in": "path",
        "required": true,
        "description": "Identifier of a catalog (a collection declared with kind: record).",
        "schema": {
          "type": "string"
        }
      },
      "recordId": {
        "name": "recordId",
        "in": "path",
        "required": true,
        "description": "Local identifier of a record within the catalog.",
        "schema": {
          "type": "string"
        }
      },
      "catalogsLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum number of catalogs in the page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 100
        }
      },
      "recordsLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum number of records in the page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 10
        }
      },
      "datetime": {
        "name": "datetime",
        "in": "query",
        "required": false,
        "description": "A date-time instant or interval, as defined by OGC API - Features - Part 1: Core. Records whose temporal column falls inside it are returned.",
        "schema": {
          "type": "string"
        }
      },
      "token": {
        "name": "token",
        "in": "query",
        "required": false,
        "description": "Opaque keyset paging cursor, echoed from the previous page's next link.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "InvalidParameter": {
        "description": "A query parameter was malformed or out of range.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such tenant, catalog, catalog record collection, or record. Also the answer when the named collection exists but is not a record collection.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/problem"
            }
          }
        }
      }
    },
    "schemas": {
      "link": {
        "type": "object",
        "required": [
          "href",
          "rel",
          "type"
        ],
        "properties": {
          "href": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "extent": {
        "type": "object",
        "properties": {
          "spatial": {
            "type": "object",
            "properties": {
              "bbox": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "crs": {
                "type": "string"
              }
            }
          }
        }
      },
      "catalog": {
        "type": "object",
        "required": [
          "id",
          "type",
          "itemType",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Collection"
            ]
          },
          "itemType": {
            "type": "string",
            "enum": [
              "record"
            ]
          },
          "title": {
            "type": "string"
          },
          "extent": {
            "$ref": "#/components/schemas/extent"
          },
          "license": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/link"
            }
          }
        }
      },
      "catalogs": {
        "type": "object",
        "required": [
          "links",
          "collections"
        ],
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/link"
            }
          },
          "collections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/catalog"
            }
          }
        }
      },
      "record": {
        "type": "object",
        "required": [
          "type",
          "id",
          "geometry",
          "properties"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Feature"
            ]
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "geometry": {
            "type": "object",
            "nullable": true
          },
          "properties": {
            "type": "object",
            "nullable": true
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/link"
            }
          }
        }
      },
      "records": {
        "type": "object",
        "required": [
          "type",
          "features",
          "numberReturned",
          "links"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "FeatureCollection"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/record"
            }
          },
          "numberMatched": {
            "type": "integer"
          },
          "numberReturned": {
            "type": "integer"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/link"
            }
          }
        }
      },
      "problem": {
        "type": "object",
        "required": [
          "status",
          "code",
          "detail"
        ],
        "properties": {
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
